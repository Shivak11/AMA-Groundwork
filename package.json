{
  "name": "ai-use-case-workshop",
  "version": "0.3.0",
  "description": "A conversational group workshop with cumulative use-case PDFs and optional MCP Apps views.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/stdio.mjs",
    "build": "node scripts/build-widget.mjs",
    "build:remote": "npm run build && wrangler deploy --dry-run --outdir dist/worker",
    "verify:http": "node scripts/verify-http.mjs",
    "test": "node --test tests/*.test.mjs",
    "examples": "node scripts/build-examples.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "1.4.0",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/server": "2.0.0",
    "playwright": "1.58.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.1",
    "typescript": "^7.0.2",
    "wrangler": "4.129.0"
  }
}
